# 复制为 .env 后填写自己的配置
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# 请按服务商实际可用模型填写
DEEPSEEK_MODEL=deepseek-flash

# 邮件功能为可选项
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=

# 图片课表识别须使用支持图像输入的模型
TIMETABLE_VISION_MODEL=deepseek-flash
# 仅在已经核实自定义端点支持图像输入后使用
TIMETABLE_VISION_ENDPOINT_CONFIRMED=false
